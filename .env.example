# 神经免疫 · 部署环境变量（docker compose 用 ${VAR} 插值读取）
# 复制为 .env 并填写：cp .env.example .env
# 注意：这个文件是「部署」配置；模型 key 等也可以在这里给（见下方模型接入段）。

# ---- 管理员（生产必填，否则后端拒绝启动）----
NEUROIMMUNE_ADMIN_USER=admin
NEUROIMMUNE_ADMIN_PASSWORD=

# ---- 机器接入 token（生产必填，未设置则 /api/ingest 拒绝接入）----
NEUROIMMUNE_API_TOKEN=

# ---- JWT 签名密钥（留空则自动生成并持久化到数据卷里的 secret.key）----
# NEUROIMMUNE_JWT_SECRET=

# ---- syslog 接收（默认 0.0.0.0 对外接收，端口映射 5514 已在 compose 打开；仅本机收改回 127.0.0.1）----
# NEUROIMMUNE_SYSLOG_BIND=0.0.0.0
# NEUROIMMUNE_SYSLOG_PORT=5514

# ---- Kafka 接入（日志云平台打日志到 Kafka，后端消费；默认连 compose 内的 kafka 服务）----
# 连外部已有 Kafka 时改这两项；留空/注释 = 使用默认 kafka:9092（compose 内自建）
# NEUROIMMUNE_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# NEUROIMMUNE_KAFKA_TOPIC=neuroimmune-logs
# NEUROIMMUNE_KAFKA_GROUP=neuroimmune

# ---- Filebeat 文件日志采集（本机日志目录，挂载到 filebeat 容器）----
# TIANYAN_LOG_DIR=/wls/applogs/rtlog/sec-terminal-linux/tianyanlog
# WAF_LOG_DIR=/wls/applogs/rtlog/sec-terminal-linux/waflog

# ---- 模型接入（可选，留空 = mock 模式先跑通架构）----
# NEUROIMMUNE_API_KEY=
# NEUROIMMUNE_BASE_URL=https://api.deepseek.com/v1
# NEUROIMMUNE_MODEL=deepseek-chat
# NEUROIMMUNE_DEEP_MODEL=deepseek-reasoner

# ---- 其它（可选）----
# NEUROIMMUNE_LOG_LEVEL=INFO
# NEUROIMMUNE_CORS_ORIGINS=          # 前后端分域时逗号分隔；同源部署留空
# NEUROIMMUNE_ALLOWED_HOSTS=*        # Host 头校验，逗号分隔
