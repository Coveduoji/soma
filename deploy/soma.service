[Unit]
Description=Soma 工作台（后端 + 前端静态托管）
After=network.target

[Service]
Type=simple
User=soma
Group=soma
WorkingDirectory=/opt/soma/backend
EnvironmentFile=/etc/soma.env
ExecStart=/opt/soma/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=3

# 数据目录 /var/lib/soma 需给 soma 用户写权限
[Install]
WantedBy=multi-user.target
