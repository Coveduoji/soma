# Soma · 模型后端配置
# 复制本文件为 .env 并填入你自己的 key（llm.py 会自动读取，不用 export）。
# key 留空 = mock 模式（零 key、零网络先跑通架构）。

# ---- 方案 A：DeepSeek（便宜，推荐先试）----
SOMA_API_KEY=sk-xxx
SOMA_BASE_URL=https://api.deepseek.com/v1
SOMA_MODEL=deepseek-chat

# ---- 方案 B：OpenRouter 免费开源模型（Qwen/Llama）----
# SOMA_API_KEY=sk-or-xxx
# SOMA_BASE_URL=https://openrouter.ai/api/v1
# SOMA_MODEL=qwen/qwen-2.5-7b-instruct:free

# ---- 方案 C：本地 Ollama（无需 key）----
# SOMA_BASE_URL=http://localhost:11434/v1
# SOMA_MODEL=qwen2.5:7b

# ---- 前额叶（深想模型）----
# 深想用推理模型；不想花钱就换成 deepseek-chat
SOMA_DEEP_MODEL=deepseek-reasoner

# ---- syslog 接收（24h 值守）----
SOMA_SYSLOG_BIND=0.0.0.0
SOMA_SYSLOG_PORT=5514
SOMA_SYSLOG_WINDOW=60

# ---- 夜间巩固间隔（秒，默认 6 小时）----
# SOMA_CONSOLIDATE_INTERVAL=21600

# ---- 可选 API token（空 = 免鉴权；部署时设）----
# SOMA_API_TOKEN=
