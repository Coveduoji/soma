{
  "天眼": {
    "parsers": [
      {
        "match": "startswith:webids_alert",
        "type": "dissect",
        "delimiter": "|!",
        "fields": [
          "alert_type",
          "serialno",
          "rule_id",
          "rule_name",
          "write_date",
          "vuln_type",
          "sip",
          "sport",
          "dip",
          "dport",
          "severity",
          "host"
        ],
        "map": {
          "time": "write_date",
          "type": "alert_type",
          "asset": "dip",
          "entities": [
            [
              "sip",
              "ip"
            ],
            [
              "dip",
              "ip"
            ],
            [
              "host",
              "domain"
            ]
          ],
          "severity": "severity",
          "severity_map": {
            "2": "low",
            "4": "medium",
            "6": "high",
            "8": "critical"
          }
        },
        "enabled": true
      },
      {
        "match": "startswith:webshell_alert",
        "type": "dissect",
        "delimiter": "|!",
        "fields": [
          "alert_type",
          "serialno",
          "rule_id",
          "host",
          "uri",
          "file_md5",
          "sip",
          "sport",
          "dip",
          "dport",
          "attack_type",
          "write_date"
        ],
        "map": {
          "time": "write_date",
          "type": "alert_type",
          "asset": "dip",
          "entities": [
            [
              "sip",
              "ip"
            ],
            [
              "dip",
              "ip"
            ],
            [
              "file_md5",
              "hash"
            ]
          ],
          "severity": "severity",
          "severity_map": {
            "2": "low",
            "4": "medium",
            "6": "high",
            "8": "critical"
          }
        }
      },
      {
        "match": "startswith:ips_alert",
        "type": "dissect",
        "delimiter": "|!",
        "fields": [
          "alert_type",
          "serialno",
          "rule_id",
          "rule_name",
          "write_date",
          "vuln_type",
          "sip",
          "sport",
          "dip",
          "dport",
          "severity"
        ],
        "map": {
          "time": "write_date",
          "type": "alert_type",
          "asset": "dip",
          "entities": [
            [
              "sip",
              "ip"
            ],
            [
              "dip",
              "ip"
            ]
          ],
          "severity": "severity",
          "severity_map": {
            "2": "low",
            "4": "medium",
            "6": "high",
            "8": "critical"
          }
        }
      },
      {
        "match": "startswith:ioc_alert",
        "type": "dissect",
        "delimiter": "|!",
        "fields": [
          "alert_type",
          "serialno",
          "rule_id",
          "host",
          "uri",
          "file_md5",
          "sip",
          "sport",
          "dip",
          "dport",
          "write_date",
          "severity",
          "confidence"
        ],
        "map": {
          "time": "write_date",
          "type": "alert_type",
          "asset": "dip",
          "entities": [
            [
              "sip",
              "ip"
            ],
            [
              "dip",
              "ip"
            ],
            [
              "host",
              "domain"
            ]
          ],
          "severity": "severity",
          "severity_map": {
            "2": "low",
            "4": "medium",
            "6": "high",
            "8": "critical"
          }
        }
      },
      {
        "type": "kv",
        "field_split": "&",
        "value_split": "=",
        "strip_prefix": "bracket_kv",
        "map": {
          "time": "_timestamp",
          "type": "alert_type",
          "asset": "dst_ip",
          "entities": [
            [
              "src_ip",
              "ip"
            ],
            [
              "dst_ip",
              "ip"
            ]
          ],
          "severity": "severity",
          "severity_map": {
            "2": "low",
            "4": "medium",
            "6": "high",
            "8": "critical"
          },
          "attack_result": "attacker_succ",
          "attack_result_map": {
            "true": "compromised",
            "false": "failed"
          }
        },
        "enabled": true
      }
    ]
  },
  "WAF": {
    "strip_syslog": true,
    "parsers": [
      {
        "match": "startswith:Timestamp/",
        "type": "kv",
        "field_split": ",",
        "value_split": "/",
        "map": {
          "time": "Timestamp",
          "type": "Event",
          "asset": "Service IP",
          "entities": [
            [
              "Client IP",
              "ip"
            ],
            [
              "Service IP",
              "ip"
            ],
            [
              "XFF Header",
              "ip"
            ]
          ],
          "severity": "Threat Level",
          "severity_map": {
            "Low": "low",
            "Medium": "medium",
            "High": "high",
            "Critical": "critical"
          },
          "attack_result": "Action",
          "attack_result_map": {
            "Deny": "blocked",
            "Block": "blocked",
            "Allow": "success",
            "Pass": "success"
          }
        }
      },
      {
        "type": "kv",
        "field_split": "&",
        "value_split": "=",
        "strip_prefix": "bracket_kv",
        "map": {
          "time": "_timestamp",
          "type": "event",
          "asset": "dst_ip",
          "entities": [
            [
              "src_ip",
              "ip"
            ],
            [
              "dst_ip",
              "ip"
            ]
          ],
          "severity": "threat_level",
          "severity_map": {
            "低风险": "low",
            "中风险": "medium",
            "高风险": "high",
            "危急": "critical"
          },
          "attack_result": "action",
          "attack_result_map": {
            "blocked": "blocked",
            "allow": "success",
            "pass": "success"
          }
        },
        "enabled": true
      }
    ]
  }
}